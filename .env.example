# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
APP_VERSION=local

# Public browser origin. Multiple origins are comma-separated.
WEB_ORIGINS=http://localhost:3001

# PostgreSQL (use a managed PostgreSQL service in staging and production)
DATABASE_URL=postgresql://license_tracker:change_me@localhost:5432/license_tracker?schema=public

# Authentication. Generate a unique value of at least 32 characters per environment.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Cookie settings. Set COOKIE_SECURE=true behind HTTPS in staging/production.
COOKIE_SECURE=false
# Production deployments enforce SameSite=None so the Vercel web app can call the Render API.
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Gmail API credentials for password-reset and reminder emails. Generate the
# refresh token locally with server/scripts/gmail-authorize.ts; never commit it.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
EMAIL_FROM=DueNest <your-verified-sender@example.com>

# Per-user Google Calendar connections. Create a separate Web application OAuth
# client in the same Google Cloud project. These values belong only on the API.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/oauth/callback
# Generate 32 random bytes and encode them as base64url. Keep the same value
# for the lifetime of the environment, otherwise saved Calendar connections
# cannot be decrypted.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Keep false on Render Free. A protected external scheduler calls the reminder endpoint.
REMINDER_SCHEDULER_ENABLED=false
REMINDER_CRON_SECRET=replace-with-a-third-long-random-secret-at-least-32-characters
