# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
APP_VERSION=local

# Public browser origin. Multiple origins are comma-separated.
WEB_ORIGINS=http://localhost:3001

# PostgreSQL (use a managed PostgreSQL service in staging and production)
DATABASE_URL=postgresql://license_tracker:change_me@localhost:5432/license_tracker?schema=public

# Authentication. Generate a unique value of at least 32 characters per environment.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Cookie settings. Set COOKIE_SECURE=true behind HTTPS in staging/production.
COOKIE_SECURE=false
COOKIE_DOMAIN=
