generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentType {
  NATIONAL_ID
  DRIVING_LICENSE
  PASSPORT
  SUBSCRIPTION
  OTHER
}

enum BillingCycle {
  MONTHLY
  YEARLY
  CUSTOM
}

enum AgeRange {
  UNDER_18
  AGE_18_24
  AGE_25_34
  AGE_35_44
  AGE_45_PLUS
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum Role {
  USER
  ADMIN
}

model User {
  id                        String        @id @default(cuid())
  email                     String        @unique
  passwordHash              String
  displayName               String?
  role                      Role          @default(USER)
  ageRange                  AgeRange?
  gender                    Gender?
  timeZone                  String        @default("Africa/Cairo")
  emailNotificationsEnabled Boolean       @default(true)
  sessions                  UserSession[]
  documents                 Document[]
  notifications             NotificationLog[]
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
}

model UserSession {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String   @unique
  deviceName       String?
  deviceType       String?
  lastUsedAt       DateTime @default(now())
  lastRefreshAt    DateTime?
  revokedAt        DateTime?
  expiresAt        DateTime
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, lastUsedAt])
}

model Document {
  id            String        @id @default(cuid())
  userId        String
  type          DocumentType
  title         String
  expiryDate    DateTime      @db.Date
  notes         String?
  providerName  String?
  renewalAmount Decimal?      @db.Decimal(12, 2)
  currency      String?       @db.VarChar(3)
  billingCycle  BillingCycle?
  isArchived    Boolean       @default(false)
  reminderRules ReminderRule[]
  notifications NotificationLog[]
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, isArchived, expiryDate])
}

model ReminderRule {
  id               String   @id @default(cuid())
  documentId       String
  daysBeforeExpiry Int
  enabled          Boolean  @default(true)
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([documentId, daysBeforeExpiry])
}

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  actorId    String
  action     String
  targetId   String?
  reason     String?
  ipAddress  String?
  
  @@index([timestamp])
  @@index([actorId])
  @@index([action])
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model NotificationLog {
  id               String             @id @default(cuid())
  documentId       String
  userId           String
  daysBefore       Int
  targetExpiryDate DateTime           @db.Date
  channel          String             @default("EMAIL")
  status           NotificationStatus @default(PENDING)
  retryCount       Int                @default(0)
  error            String?
  sentAt           DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  document         Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Ensures we never send the exact same reminder for the same expiry date
  @@unique([documentId, daysBefore, targetExpiryDate])
  @@index([status, retryCount])
  @@index([userId])
}
